{
  "name": "shopify-mcp-multiaccount",
  "version": "2.0.0",
  "description": "MCP server for Shopify — manage many Shopify stores from one server and switch between them mid-conversation, via the Admin GraphQL API",
  "main": "dist/index.js",
  "bin": {
    "shopify-mcp-multiaccount": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/client.mjs && node test/smoke.mjs",
    "validate:graphql": "graphql-codegen --config .graphqlrc.ts",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "multi-account",
    "multi-store",
    "graphql",
    "ai",
    "llm",
    "claude"
  ],
  "author": {
    "name": "puloxtor"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.7",
    "minimist": "^1.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@shopify/admin-api-client": "^1.1.2",
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "@types/minimist": "^1.2.2",
    "@types/node": "^18.15.11",
    "graphql": "^16.13.1",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  },
  "files": [
    "dist",
    "shopify-stores.example.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puloxtor/shopify-mcp-multiaccount.git"
  },
  "bugs": {
    "url": "https://github.com/puloxtor/shopify-mcp-multiaccount/issues"
  },
  "homepage": "https://github.com/puloxtor/shopify-mcp-multiaccount#readme",
  "engines": {
    "node": ">=18.17.0"
  }
}
